{
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "duyet-web.vercel.app" }],
      "destination": "https://www.duyet.com.vn/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
      ]
    },
    { "source": "/tools/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/.github/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/audio/texts.json", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/audio/manifest.json", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/DUONG-LINK.md", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/llms.txt", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }] }
  ]
}
